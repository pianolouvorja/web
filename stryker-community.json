{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress", "json"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.config.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/modules/community/services/**/*.ts",
    "!src/modules/community/services/__tests__/**"
  ],
  "thresholds": {
    "high": 95,
    "low": 80,
    "break": 80
  },
  "timeoutMS": 30000,
  "concurrency": 4,
  "ignorePatterns": [
    "**/node_modules/**",
    "e2e/**",
    "site/**",
    ".stryker-tmp/**"
  ]
}